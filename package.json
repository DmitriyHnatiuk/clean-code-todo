{
  "name": "clean-code-todo",
  "version": "1.0.0",
  "description": "Учебный репозиторий для задания [«Clean Code»](https://github.com/rolling-scopes-school/tasks/blob/master/fullstack-engineering/tasks/clean-code/README.md) курса RS School Fullstack Engineering.",
  "homepage": "https://github.com/DmitriyHnatiuk/clean-code-todo#readme",
  "bugs": {
    "url": "https://github.com/DmitriyHnatiuk/clean-code-todo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DmitriyHnatiuk/clean-code-todo.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "app.js",
  "lint-staged": {
    "*.{js}": [
      "prettier --check",
      "eslint"
    ],
    "*.{css,md,json, html}": [
      "prettier --check"
    ]
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:js": "eslint .",
    "lint:js-fix": "eslint . --fix",
    "lint": "npm run format:check & npm run lint:js",
    "lint:fix": "npm run format & npm run lint:js-fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  }
}
